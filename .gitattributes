# Force LF for everything git ships. A CRLF that survives into a GitHub Actions
# `run:` block becomes a literal carriage return in the executed shell script,
# and bash fails with $'\r': command not found — which only shows up in CI.
* text=auto eol=lf

*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.html  text eol=lf
*.toml  text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
