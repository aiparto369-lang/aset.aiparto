# Capital Compass provider credentials
# Never commit real keys.

ALPHAVANTAGE_API_KEY=
METALS_API_KEY=

# Providers are disabled by default until rights/licensing review is complete.
CC_ENABLE_ALPHA_VANTAGE=false
CC_ENABLE_METALS_API=false

# --- Telegram delivery (optional) ---
# Nothing is ever sent unless BOTH are set.
# Token from @BotFather; a channel chat id looks like -100xxxxxxxxxx
CC_TELEGRAM_TOKEN=
CC_TELEGRAM_CHAT=
